(footprint "LED1206-RM_XL-3216_K1"
	(version 20240108)
	(generator "pcbnew")
	(layer "F.Cu")
	(descr "1206 reverse-mount (back-emitting) LED, XINGLIGHT XL-3216 series. Pads 0.8x1.5 at +-1.4 mm (datasheet), 1.4 mm NPTH window for the light. Cathode on the -x side (silk bar). Pad 1 = cathode, pad 2 = anode (for symbols with pin 1 = cathode).")
	(attr smd)
	(property "Reference" "REF**" (at 0 -2.2 0) (layer "F.SilkS") (effects (font (size 1 1) (thickness 0.15))))
	(property "Value" "LED1206-RM_XL-3216_K1" (at 0 2.2 0) (layer "F.Fab") (effects (font (size 1 1) (thickness 0.15))))
	(fp_line (start -1.0 -1.0) (end 1.0 -1.0) (stroke (width 0.15) (type default)) (layer "F.SilkS"))
	(fp_line (start -1.0 1.0) (end 1.0 1.0) (stroke (width 0.15) (type default)) (layer "F.SilkS"))
	(fp_line (start -2.2 -0.9) (end -2.2 0.9) (stroke (width 0.25) (type default)) (layer "F.SilkS"))
	(fp_rect (start -1.6 -0.8) (end 1.6 0.8) (stroke (width 0.1) (type default)) (fill none) (layer "F.Fab"))
	(fp_rect (start -2.05 -1.1) (end 2.05 1.1) (stroke (width 0.05) (type default)) (fill none) (layer "F.CrtYd"))
	(pad "2" smd rect (at 1.4 0) (size 0.8 1.5) (layers "F.Cu" "F.Paste" "F.Mask"))
	(pad "1" smd rect (at -1.4 0) (size 0.8 1.5) (layers "F.Cu" "F.Paste" "F.Mask"))
	(pad "" np_thru_hole circle (at 0 0) (size 1.4 1.4) (drill 1.4) (layers "*.Cu" "*.Mask"))
	(model "${KIPRJMOD}/lib/LEDStars.3dshapes/LED1206-RM_XL-3216.wrl"
		(offset (xyz 0 0 0))
		(scale (xyz 1 1 1))
		(rotate (xyz 0 0 0))
	)
)
